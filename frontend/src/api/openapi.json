    "/api/v1/forecast": {
      "get": {
        "tags": [
          "Forecast"
        ],
        "summary": "Api Forecast",
        "description": "Returns multi-horizon forecast timeseries for a given node with split-conformal\nprediction interval bands (90% and 95%).",
        "operationId": "api_forecast_api_v1_forecast_get",
        "parameters": [
          {
            "name": "node",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Node unique_id (e.g. 'India', 'India/NR', 'India/NR/Delhi')",
              "default": "India",
              "title": "Node"
            },
            "description": "Node unique_id (e.g. 'India', 'India/NR', 'India/NR/Delhi')"
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 14,
              "minimum": 1,
              "description": "Forecast horizon in days (1..14)",
              "default": 14,
              "title": "Horizon"
            },
            "description": "Forecast horizon in days (1..14)"
          },
          {
            "name": "intervals",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Whether to include split-conformal prediction intervals",
              "default": true,
              "title": "Intervals"
            },
            "description": "Whether to include split-conformal prediction intervals"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "Hierarchy"
        ],
        "summary": "Api Hierarchy",
        "description": "Returns complete 3-level hierarchy snapshot (National, 5 Regions, 45 Leaves)\nand reports the exact mathematical coherence gap in MU/day.",
        "operationId": "api_hierarchy_api_v1_hierarchy_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Date in YYYY-MM-DD (defaults to latest available)",
              "title": "Date"
            },
            "description": "Date in YYYY-MM-DD (defaults to latest available)"
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 14,
              "minimum": 1,
              "description": "Forecast horizon 1..14",
              "default": 1,
              "title": "Horizon"
            },
            "description": "Forecast horizon 1..14"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(actual|unreconciled|reconciled)$",
              "description": "Display mode",
              "default": "reconciled",
              "title": "Mode"
            },
            "description": "Display mode"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchySnapshotResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenario": {
      "post": {
        "tags": [
          "Scenario Simulation"
        ],
        "summary": "Api Scenario",
        "description": "Simulates a what-if demand shock at any node and computes both Proportional\nand Covariance-Aware allocations across all 51 nodes, verifying mathematical coherence.\nIncludes historical bounds warnings, physical non-negativity checks, and heuristic stress alerts.",
        "operationId": "api_scenario_api_v1_scenario_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts": {
      "get": {
        "tags": [
          "Stress Indicators"
        ],
        "summary": "Api Alerts",
        "description": "Evaluates 4 heuristic stress indicators: Demand Stress, Supply Deficit,\nHistorical Shortage Frequency (with sample size gating), and Low Demand Backing-Down.",
        "operationId": "api_alerts_api_v1_alerts_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reference date YYYY-MM-DD",
              "title": "Date"
            },
            "description": "Reference date YYYY-MM-DD"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter for specific region: NR, WR, SR, ER, NER, or India",
              "title": "Region"
            },
            "description": "Filter for specific region: NR, WR, SR, ER, NER, or India"
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 12,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Calendar month 1..12",
              "title": "Month"
            },
            "description": "Calendar month 1..12"
