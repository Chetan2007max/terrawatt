# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including OpenMP runtime for LightGBM
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Prevent python from buffering stdout/stderr and enforce single thread for LightGBM
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 \
    PORT=8000

# Install pinned Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code, trained models, and artifacts
COPY src/ ./src/
COPY api/ ./api/
COPY scripts/ ./scripts/
COPY artifacts/ ./artifacts/
COPY data/processed/ ./data/processed/
COPY models/artifacts/ ./models/artifacts/

EXPOSE 8000

# Health check against versioned health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

